PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (free tier) — get from cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/skillnest

# Any long random string
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=30d

# Your deployed frontend URL (Vite dev server by default)
CLIENT_URL=http://localhost:5173
